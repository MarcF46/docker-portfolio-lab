# .gitignore
# Zweck:
# - lokale, sensible oder automatisch erzeugte Dateien nicht in Git aufnehmen
# - Repository sauber halten
# - Backups, Logs, lokale Secrets und persönliche Notizen schützen

# Lokale Umgebungsdateien / Passwörter
.env
.env.*
*.env
!.env.example

# Lokale Secret-Dateien
# Der Ordner darf existieren, aber echte Secret-Dateien sollen nicht nach GitHub.
secrets/*
!secrets/.gitkeep

# Lokale Backups nicht zu GitHub hochladen
backups/
*.tar
*.tar.gz
*.tgz
*.zip

# Logs
logs/*
!logs/.gitkeep
*.log

# Terminal-/Incident-Mitschnitte
logs/terminal-sessions/

# Word-Dokumente / lokale Lernunterlagen
*.docx
*.xlsx
*.pptx

# Temporäre Dateien
tmp/
temp/
*.tmp

# Lokale Notizen
Notizen/

# VS-Code lokale Projektdateien
.vscode/
*.code-workspace

# Alte Testdateien / lokale Altstände
docker-compose_alt.yml

# Windows-Systemdateien
Thumbs.db
Desktop.ini

# macOS-Systemdateien, falls das Projekt später auf einem Mac geöffnet wird
.DS_Store
