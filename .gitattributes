# .gitattributes
# Zweck:
# - Einheitliche Zeilenenden im Repository
# - Weniger LF/CRLF-Warnungen
# - Bessere Zusammenarbeit zwischen Windows, Linux, macOS, Docker und GitHub

# Standardregel:
# Alle Textdateien werden im Repository mit LF gespeichert.
# Das ist für Docker-, Linux-, Kubernetes- und CI/CD-nahe Projekte eine robuste Grundeinstellung.
* text=auto eol=lf

# Shell- und Linux-/Container-nahe Dateien sollen LF behalten.
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# YAML/YML wird für Docker Compose, Kubernetes und CI/CD verwendet.
# LF ist hier eine gute plattformübergreifende Grundeinstellung.
*.yml text eol=lf
*.yaml text eol=lf

# Markdown- und Textdokumentation ebenfalls einheitlich mit LF.
*.md text eol=lf
*.txt text eol=lf

# PowerShell läuft auch mit LF-Zeilenenden.
# Dadurch bleibt das Repository einheitlich.
*.ps1 text eol=lf

# Web-/Konfigurationsdateien.
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf

# Windows-spezifische Batchdateien, falls später welche dazukommen.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binärdateien niemals als Text normalisieren.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip binary
*.gz binary
*.tar binary
*.tgz binary
*.tar.gz binary
